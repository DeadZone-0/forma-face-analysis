  "narrative": {
    "northStar": "The Geometry Workbench",
    "overview": "Forma is an operating tool for inspecting a portrait and the measurements derived from it. Deep green surfaces recede behind the photograph; pale green actions and teal landmark geometry guide attention. The interface stays precise and restrained through compact labels, clear dividers, and quietly differentiated states.\n\nThis document records the implemented workspace, rather than an approved visual comp. The north star names the observed direction; it is not a separately approved brand identity.",
    "keyCharacteristics": [
      "Portrait-led analysis with a companion report.",
      "Dark green tonal surfaces and pale green actions.",
      "Border-separated measurements linked to visible geometry.",
      "Compact sans-serif typography with explicit focus and selected states."
    ],
    "rules": [
      {
        "name": "The Geometry Rule",
        "body": "Reserve the brightest green lines and points for geometry drawn over the photograph; keep interface surfaces quiet.",
        "section": "colors"
      },
      {
        "name": "The Shared Frame Rule",
        "body": "Keep the analysis panes inside one continuous bordered surface and separate report rows with lines.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the portrait-to-measurement relationship and visible selected states.",
      "Do use the shared frame, tonal fills, and dividers for structure.",
      "Do keep keyboard focus conspicuous and respect reduced motion.",
      "Do stack the portrait before the report on small screens."
    ],
    "donts": [
      "Don't turn each measurement into a nested card.",
      "Don't apply canvas-bright landmark colors to large interface surfaces.",
      "Don't shrink supporting text below the implemented 11px label size.",
      "Don't hide the distinction between sample and uploaded-photo results."
    ]
  }
}
